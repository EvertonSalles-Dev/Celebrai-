{
  "name": "celebrai",
  "version": "1.0.0",
  "private": true,
  "description": "Celebrai — Convites inteligentes, RSVP e controle de entrada com QR Code.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm run dev --workspace @celebrai/api",
    "dev:web": "npm run dev --workspace @celebrai/web",
    "build": "npm run build --workspace @celebrai/api && npm run build --workspace @celebrai/web && node -e \"require('fs').cpSync('packages/web/dist', 'dist', {recursive: true})\"",
    "build:vercel": "node scripts/build-vercel.mjs",
    "build:local": "npm run build:local --workspace @celebrai/api",
    "build:web": "npm run build --workspace @celebrai/web",
    "db:bootstrap": "npm run bootstrap:db --workspace @celebrai/api",
    "test": "npm run test --workspace @celebrai/api",
    "db:generate": "npm run db:generate --workspace @celebrai/api",
    "db:migrate": "npm run db:migrate --workspace @celebrai/api",
    "db:seed": "npm run db:seed --workspace @celebrai/api",
    "lint": "npm run lint --workspace @celebrai/api && npm run lint --workspace @celebrai/web"
  },
  "devDependencies": {
    "@vercel/node": "^3.2.24",
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": "24.x"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.63.3",
    "@rollup/rollup-win32-x64-msvc": "^4.63.3"
  }
}