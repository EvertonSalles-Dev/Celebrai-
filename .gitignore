# Dependencies
node_modules/
.pnp
.pnp.js

# Builds
dist/
build/
*.tsbuildinfo
# Bundle do frontend — artefato de build, não versionado.
packages/web/dist/

# `.env*` abaixo NÃO pode voltar a ser um catch-all: `.env.example` é versionado
# (é o contrato das variáveis de ambiente) e a exceção `!` só vale se o
# ignore vier antes.

# Variáveis de ambiente — nunca versionadas.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Databases
*.db
*.db-journal
packages/api/prisma/dev.db
packages/api/prisma/dev.db-journal
# Schema de desenvolvimento gerado por packages/api/scripts/set-provider.mjs
packages/api/prisma/schema.dev.prisma

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Uploads
packages/api/uploads/
packages/api/storage/

# Pasta criada por engano por um comando malformado (ex.: create-next-app --template).
# Tem ~400 MB de um projeto Next.js inteiro. Não faz parte do Celebrai.
--template/

# Logs da API gerados localmente
packages/api/*.out.log
packages/api/*.err.log
# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Coverage
coverage/
.nyc_output/

.vercel
