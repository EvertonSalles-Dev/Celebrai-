# ============================================================================
# Celebrai — exemplo de variáveis de ambiente
# Copie para `.env` e ajuste os valores. NUNCA comite o `.env` real.
# ============================================================================

# ---------- Aplicação ----------
NODE_ENV=development
PORT=3333
API_PREFIX=/api
# URL pública do frontend (usada para montar os links de convite)
APP_URL=http://localhost:5173
# URL pública da API
API_URL=http://localhost:3333

# ---------- Banco de dados ----------
# PRODUÇÃO / DESENVOLVIMENTO COM POSTGRES
DATABASE_URL="postgresql://celebrai:celebrai@localhost:5432/celebrai?schema=public"
# Provider do Prisma: postgresql | sqlite
DATABASE_PROVIDER=postgresql

# ---------- Autenticação ----------
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=troque-este-segredo-de-acesso-em-producao
JWT_REFRESH_SECRET=troque-este-segredo-de-refresh-em-producao
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Peppers/extras
INVITATION_TOKEN_SECRET=troque-este-segredo-de-convites-em-producao
BCRYPT_ROUNDS=12

# ---------- CORS ----------
# Lista separada por vírgula.
# Lista estritamente explícita: para acessar o dev server por outro IP/host
# (ex.: http://192.168.56.1:5173), adicione-o aqui.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173

# ---------- Rate limiting ----------
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
# Limite específico para o endpoint público de check-in / validação
CHECKIN_RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10

# ---------- E-mail (SMTP) ----------
MAIL_DRIVER=smtp
MAIL_FROM="Celebrai <no-reply@celebrai.app>"
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ---------- WhatsApp Business (Cloud API oficial) ----------
WHATSAPP_DRIVER=disabled
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v20.0

# ---------- Geo / Mapas ----------
GOOGLE_MAPS_API_KEY=

# ---------- Super Admin (seed) ----------
SEED_SUPER_ADMIN_NAME="Super Admin"
SEED_SUPER_ADMIN_EMAIL=super@celebrai.app
SEED_SUPER_ADMIN_PASSWORD=SuperAdmin@123
